<?xml version="1.0" encoding="utf-8"?>
<!--
    [T-android-chat-strings-resource] Chat-module strings. New standalone file
    (Android merges res/values* across files automatically) so parallel fix
    waves never collide on the shared values/strings.xml.
    English defaults; the current Chinese display copy lives in
    values-zh/strings_chat.xml verbatim until the translation pass rewrites it.
-->
<resources>
    <!-- Foreground approval gate (ChatSheetsHost) -->
    <string name="approval_required_title">Approval needed: %1$s</string>
    <string name="approval_default_preview">Agent requests to run a sensitive operation</string>
    <string name="approval_action_approve">Approve</string>
    <string name="approval_action_deny">Deny</string>
    <string name="approval_action_allow_all_session">Allow all this session</string>

    <!-- Crash recovery (ChatScreen) -->
    <string name="crash_recovery_snackbar">Last generation was interrupted (model %1$s, started at %2$s) — content produced before the interruption is preserved in the conversation</string>

    <!-- Attachment pick truncation (ChatScreen) -->
    <string name="attachment_pick_truncated_items">Only the first %1$d items were attached.</string>
    <string name="attachment_pick_truncated_files">Only the first %1$d files were attached.</string>

    <!-- Chat screen misc -->
    <string name="chat_move_to_capsule">Move to…</string>
    <string name="attachment_no_app_toast">No app available to open this attachment.</string>

    <!-- Sub-agent live bar + detail sheet (ChatSubAgentBar) -->
    <string name="subagent_waiting_first_output">Thinking, no output yet</string>
    <string name="subagent_turn_of">Turn %1$d of %2$d</string>
    <string name="subagent_index_of_total">Sub-agent %1$d/%2$d</string>
    <string name="subagent_fallback_label">Sub-agent</string>
    <string name="subagent_task_fallback">Sub-agent task</string>
    <string name="subagent_stop_desc">Stop %1$s</string>
    <string name="subagent_status_running">Running</string>
    <string name="subagent_status_calling_tool">Calling tool</string>
    <string name="subagent_status_done">Done</string>
    <string name="subagent_status_failed">Failed</string>
    <string name="subagent_args_label">Args</string>
    <string name="subagent_result_label">Result</string>

    <!-- Accessibility labels (ChatComposerWidgets / ChatToolDetailUI) -->
    <string name="attachment_remove_desc">Remove attachment</string>
    <string name="tool_detail_prev_desc">Previous</string>
    <string name="tool_detail_next_desc">Next</string>

    <!-- ToolCallPill long-press menu (new items consuming onRetry /
         onOpenTerminalWithCommand; siblings tool_longpress_rerun_from_here /
         tool_longpress_copy_details live in the shared strings.xml) -->
    <string name="tool_longpress_retry">Retry</string>
    <string name="tool_longpress_open_in_terminal">Open in terminal</string>
</resources>
