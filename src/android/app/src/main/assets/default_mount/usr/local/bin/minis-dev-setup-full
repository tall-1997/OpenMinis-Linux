#!/bin/sh
# Full developer toolchain: gcc, cmake, ffmpeg, openjdk-21, golang-go, gradle.
# This is HEAVY (500MB+ download). Run interactively or in background.
# Prerequisites: minis-dev-setup must run first.

set -e
export DEBIAN_FRONTEND=noninteractive
export SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
export TMPDIR=/tmp TMP=/tmp TEMP=/tmp

echo "minis-dev-setup-full: installing heavy toolchain (500+ MB)"
echo "This will take 10-20 minutes on slow networks. Press Ctrl+C to abort."
sleep 3

if ! command -v apt-get >/dev/null 2>&1; then
  echo "ERROR: apt-get not found" >&2
  exit 1
fi

# Acquire lock with longer timeout
if [ -f /usr/local/lib/minis/apt-lock.sh ]; then
  . /usr/local/lib/minis/apt-lock.sh
  if ! minis_acquire_apt_lock 1800; then
    echo "ERROR: apt locked for 30min, aborting" >&2
    exit 1
  fi
  trap 'minis_release_apt_lock' EXIT
fi

# EXIT releases the lock. A signal that only releases and returns lets the
# next apt-get run without the lock.
trap 'echo "Received SIGTERM, cleaning up..."; exit 143' TERM
trap 'echo "minis-dev-setup-full: interrupted"; exit 130' INT

echo "Updating package lists..."
apt-get update || true

echo "Installing build tools..."
apt-get install -y --no-install-recommends \
  bash bash-completion \
  build-essential gcc g++ make cmake ninja-build pkg-config \
  python3-venv python3-dev \
  || true

echo "Installing multimedia..."
apt-get install -y --no-install-recommends ffmpeg || true

echo "Installing Java..."
apt-get install -y --no-install-recommends openjdk-21-jdk-headless || \
  apt-get install -y --no-install-recommends openjdk-17-jdk-headless || true

echo "Installing additional tools..."
apt-get install -y --no-install-recommends \
  tar xz-utils zip file \
  openssh-client rsync sqlite3 \
  || true

echo "Installing Go..."
apt-get install -y --no-install-recommends golang-go || true

echo "Installing Gradle..."
apt-get install -y --no-install-recommends gradle || true

dpkg --configure -a || true

# Find JAVA_HOME
JAVA_HOME=""
for d in /usr/lib/jvm/java-21-openjdk-arm64 /usr/lib/jvm/java-17-openjdk-arm64 /usr/lib/jvm/default-java; do
  if [ -d "$d" ]; then JAVA_HOME=$d; break; fi
done
if [ -z "$JAVA_HOME" ]; then
  JAVA_HOME=$(ls -d /usr/lib/jvm/java-*-openjdk-arm64 2>/dev/null | head -1 || true)
fi

# Update profile
umask 022
cat > /etc/profile.d/minis-dev-full.sh <<EOF
# Generated by minis-dev-setup-full
${JAVA_HOME:+export JAVA_HOME=$JAVA_HOME}
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
${JAVA_HOME:+export PATH="\$JAVA_HOME/bin:\$PATH"}
export PATH="\$PATH:/opt/gradle/bin:/opt/android-sdk/cmdline-tools/latest/bin"
EOF

echo
echo "Full toolchain installed:"
echo "  gcc:     $(command -v gcc 2>/dev/null || echo missing)"
echo "  cmake:   $(command -v cmake 2>/dev/null || echo missing)"
echo "  ninja:   $(command -v ninja 2>/dev/null || echo missing)"
echo "  ffmpeg:  $(command -v ffmpeg 2>/dev/null || echo missing)"
echo "  java:    $(command -v java 2>/dev/null || echo missing)"
echo "  gradle:  $(command -v gradle 2>/dev/null || echo missing)"
echo "  go:      $(command -v go 2>/dev/null || echo missing)"
echo
echo "Re-login or run: . /etc/profile.d/minis-dev-full.sh"
