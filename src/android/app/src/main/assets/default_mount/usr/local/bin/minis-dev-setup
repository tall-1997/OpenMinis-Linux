#!/bin/sh
# Lightweight seed: only essential network tools (ca-certs, curl, git, python, node).
# Full toolchain (gcc, ffmpeg, jdk, golang) moved to separate minis-dev-setup-full.
# Safe to re-run; runs in ~30s even on slow networks.

set -e
export DEBIAN_FRONTEND=noninteractive
export SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
export TMPDIR=/tmp TMP=/tmp TEMP=/tmp
mkdir -p /tmp /var/tmp
chmod 1777 /tmp /var/tmp 2>/dev/null || true

echo "minis-dev-setup: lightweight seed (curl, wget, python3, git, nodejs)"

if ! command -v apt-get >/dev/null 2>&1; then
  echo "ERROR: apt-get not found" >&2
  exit 1
fi

# Acquire lock
if [ -f /usr/local/lib/minis/apt-lock.sh ]; then
  . /usr/local/lib/minis/apt-lock.sh
  if ! minis_acquire_apt_lock 60; then
    echo "WARNING: apt busy, skipping seed" >&2
    exit 0
  fi
  trap 'minis_release_apt_lock' EXIT INT TERM
fi

# Handle SIGTERM for graceful shutdown
trap 'echo "minis-dev-setup: received SIGTERM, exiting"; exit 143' TERM

echo "Updating package lists..."
# Never disable TLS verification. If the injected CA bundle cannot verify the
# current mirror, drop the apt lock and let minis-mirror walk its HTTPS→HTTP
# chain, then retry once.
if ! apt-get update; then
  echo "apt-get update failed; trying minis-mirror auto" >&2
  if type minis_release_apt_lock >/dev/null 2>&1; then
    minis_release_apt_lock || true
  fi
  if command -v minis-mirror >/dev/null 2>&1; then
    minis-mirror auto || true
  fi
  if [ -f /usr/local/lib/minis/apt-lock.sh ]; then
    # shellcheck source=/dev/null
    . /usr/local/lib/minis/apt-lock.sh
    minis_acquire_apt_lock 60 || true
  fi
  apt-get update || true
fi

echo "Installing essential tools..."
apt-get install -y --no-install-recommends \
  ca-certificates curl wget \
  python3 python3-pip \
  git git-lfs \
  nodejs npm \
  psmisc unzip \
  || apt-get install -y --no-install-recommends \
       ca-certificates curl wget python3 git nodejs psmisc unzip \
  || true

update-ca-certificates 2>/dev/null || true

echo
echo "Essential tools installed:"
echo "  curl:    $(command -v curl 2>/dev/null || echo missing)"
echo "  wget:    $(command -v wget 2>/dev/null || echo missing)"
echo "  python3: $(command -v python3 2>/dev/null || echo missing)"
echo "  git:     $(command -v git 2>/dev/null || echo missing)"
echo "  node:    $(command -v node 2>/dev/null || command -v nodejs 2>/dev/null || echo missing)"
echo "  npm:     $(command -v npm 2>/dev/null || echo missing)"
echo
echo "For full toolchain (gcc, ffmpeg, jdk, golang), run: minis-dev-setup-full"
